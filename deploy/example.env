# Required
CALLSIGN=N0CALL
DMR_ID=1234567
RADIO_MODEL=d878uv2            # dmrconf radio key: d868uve, d878uv, d878uv2, d578uv, dmr6x2, opengd77, gd77, uv380, md390, rt3s, dm1701, rd5r ...
# Hotspot: HOTSPOT_KIND = wpsd | pistar (both over SSH) | openspot (HTTP API, experimental) | none
HOTSPOT_KIND=wpsd
HOTSPOT_HOST=192.168.1.50      # ssh host for wpsd/pistar, web address for openspot
WPSD_USER=pi-star              # ssh user (wpsd/pistar)
HOTSPOT_PASSWORD=              # ssh password for the first connection (the server then installs its own key, see
                               # wpsd_ssh_pubkey) / the openSPOT web-UI password
# Radio link: DIFF_WRITE=0 disables the differential write, USB_RELAY=0 bypasses the relay for a server-USB radio
# Optional APIs
BM_API_KEY=                    # BrandMeister SelfCare > Profile > API keys (needed for static TG changes)
REPEATERBOOK_TOKEN=
