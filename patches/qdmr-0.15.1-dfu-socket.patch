+    return LIBUSB_ERROR_NO_DEVICE;
+  if ((! in) && len && data && (! _io_all(_sock, data, len, true)))
+    return LIBUSB_ERROR_NO_DEVICE;
+  unsigned char st[4];
+  if (! _io_all(_sock, st, 4, false))
+    return LIBUSB_ERROR_TIMEOUT;
+  int32_t status = (int32_t)((uint32_t)st[0] | ((uint32_t)st[1] << 8) | ((uint32_t)st[2] << 16) | ((uint32_t)st[3] << 24));
+  if (in && (status > 0)) {
+    if (status > len) return LIBUSB_ERROR_OVERFLOW;
+    if (! _io_all(_sock, data, (size_t)status, false))
+      return LIBUSB_ERROR_TIMEOUT;
+  }
+  return status;
 }
 
