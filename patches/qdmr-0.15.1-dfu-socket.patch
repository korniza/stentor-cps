+static bool
+_io_all(int fd, unsigned char *buf, size_t n, bool wr) {
+  while (n > 0) {
+    ssize_t k = wr ? ::send(fd, buf, n, MSG_NOSIGNAL) : ::recv(fd, buf, n, 0);
+    if (k <= 0) return false;
+    buf += k; n -= (size_t)k;
+  }
+  return true;
+}
