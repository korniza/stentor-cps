+int
+DFUDevice::ctrl(uint8_t reqType, uint8_t req, uint16_t value, uint16_t index, unsigned char *data, uint16_t len) {
+  if (_sock < 0)
+    return libusb_control_transfer(_dev, reqType, req, value, index, data, len, 0);
+  // request: 'C' type req value(le16) index(le16) length(le16) [data when host->device]
+  // answer:  status (le32: bytes transferred, or a negative libusb error) [data when device->host and status > 0]
+  unsigned char hdr[9] = { 'C', reqType, req, (unsigned char)(value & 0xff), (unsigned char)(value >> 8),
+                           (unsigned char)(index & 0xff), (unsigned char)(index >> 8),
+                           (unsigned char)(len & 0xff), (unsigned char)(len >> 8) };
